name: Build & Push 🚀 | DevOps Generic Image ⎈

on:
    push:
        paths:
            - 'devops-generic/**'
    workflow_dispatch:

jobs:

    build-and-push:
        runs-on: beta-runner-set-custom
        steps:

        - name: Checkout the repository
          uses: actions/checkout@v4
        
        - name: Set up Docker Buildx
          uses: docker/setup-buildx-action@v3
  
        - name: Login to Docker Hub
          uses: docker/login-action@v3
          with:
            username: ${{ secrets.DOCKERHUB_USERNAME }}
            password: ${{ secrets.DOCKERHUB_TOKEN }}

        - name: Build and push
          uses: docker/build-push-action@v5
          with:
            context: ./devops-generic/
            push: true
            file: ./devops-generic/Dockerfile
            tags: ${{ secrets.DOCKERHUB_USERNAME }}/devops-generic:latest
    